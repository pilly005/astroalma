# ============================================================
# AstroAlma — environment variables
# Copy this file to `.env` and fill in REAL values.
# The build FAILS LOUDLY if any of these are missing —
# the app must NEVER ship with RevenueCat in demo mode.
# (.env is gitignored and will NOT be in GitHub ZIPs.)
# ============================================================

# Supabase project URL (Project Settings → Data API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon/public key (Project Settings → API Keys)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# RevenueCat PUBLIC iOS API key (RevenueCat dashboard → Project → API keys)
# Starts with "appl_". NEVER the secret key.
VITE_REVENUECAT_IOS_KEY=appl_YOUR_IOS_PUBLIC_KEY_HERE
